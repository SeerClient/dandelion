{
  "schemaVersion": 1,
  "id": "dandelion",
  "version": "1.0.0-alpha.22",
  "name": "Dandelion",
  "description": "Dandelion is a config abstraction that supports both YACL and MoulConfig backends.",
  "authors": [
    "AzureAaron"
  ],
  "contributors": [
    "nea89",
    "kevinthegreat1",
    "Alex33856",
    "viciscat",
    "Bedrock Armor"
  ],
  "contact": {
    "homepage": "https://azureaaron.net/",
    "sources": "https://github.com/AzureAaron/Dandelion"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/dandelion/icon.png",
  "environment": "client",
  "runtime": "native",
  "file": "dandelion.dll",
  "entrypoints": {
    "preLaunch": [
      "Mixins"
    ],
    "client": [
      "dandelion::Client"
    ]
  },
  "depends": {
    "minecraft": "~26.3",
    "seer": ">=0.1.0"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "update_checker": false
    },
    "fabric2seer": {
      "source": "repo",
      "names": "mojang",
      "original_depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
      }
    },
    "seer:pack": {
      "include": [
        "moulconfig.dll"
      ]
    }
  }
}